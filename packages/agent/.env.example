# Written for you by `yarn agent:setup` (owner bootstrap). Fill in manually to use an existing vault.

# testnet | mainnet
HEDERA_NETWORK=testnet
# AgentVault the agent spends from (create one in the dashboard or with `yarn agent:setup`)
VAULT_ADDRESS=
# The agent's ECDSA private key (0x...). Its address must have a policy on the vault.
AGENT_PRIVATE_KEY=
# The agent's Hedera account ID (0.0.x); looked up from the mirror node when empty
AGENT_ACCOUNT_ID=
# Allowlisted recipient used by `yarn agent:demo`
DEMO_MERCHANT=
# Only for `yarn agent:chat` (or run `ant auth login` instead)
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default claude-opus-5-5)
CLAUDE_MODEL=
